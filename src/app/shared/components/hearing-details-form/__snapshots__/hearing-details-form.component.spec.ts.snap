                                        disabled=""
                                        id="pdk-radio-GENERATED_ID"
                                        name="pdk-radio-group-GENERATED_ID"
                                        type="radio"
                                        value="1"
                                      />
                                      <label
                                        class="govuk-radios__label govuk-label"
                                        for="pdk-radio-GENERATED_ID"
                                        pdk-label=""
                                      >
                                        One week 
                                      </label>
                                    </div>
                                  </pdk-radio-button>
                                  <pdk-radio-button
                                    name="twoWeeks"
                                    type="radio"
                                  >
                                    <div
                                      class="govuk-radios__item"
                                    >
                                      <input
                                        class="govuk-radios__input"
                                        disabled=""
                                        id="pdk-radio-GENERATED_ID"
                                        name="pdk-radio-group-GENERATED_ID"
                                        type="radio"
                                        value="2"
                                      />
                                      <label
                                        class="govuk-radios__label govuk-label"
                                        for="pdk-radio-GENERATED_ID"
                                        pdk-label=""
                                      >
                                        Two weeks 
                                      </label>
                                    </div>
                                  </pdk-radio-button>
                                </div>
                              </pdk-radio-group>
                            </fieldset>
                          </pdk-form-group>
                        </pdk-form-field>
                        <pdk-form-field
                          label="Hearing duration"
                          labeltype="small"
                        >
                          <pdk-form-group
                            class="pdk-form-group"
                          >
                            <fieldset
                              class="govuk-fieldset"
                              pdk-fieldset=""
                            >
                              <legend
                                class="govuk-fieldset__legend govuk-fieldset__legend--s"
                              >
