                                                                    d="M148 288h-40c-6.6 0-12-5.4-12-12v-40c0-6.6 5.4-12 12-12h40c6.6 0 12 5.4 12 12v40c0 6.6-5.4 12-12 12zm108-12v-40c0-6.6-5.4-12-12-12h-40c-6.6 0-12 5.4-12 12v40c0 6.6 5.4 12 12 12h40c6.6 0 12-5.4 12-12zm96 0v-40c0-6.6-5.4-12-12-12h-40c-6.6 0-12 5.4-12 12v40c0 6.6 5.4 12 12 12h40c6.6 0 12-5.4 12-12zm-96 96v-40c0-6.6-5.4-12-12-12h-40c-6.6 0-12 5.4-12 12v40c0 6.6 5.4 12 12 12h40c6.6 0 12-5.4 12-12zm-96 0v-40c0-6.6-5.4-12-12-12h-40c-6.6 0-12 5.4-12 12v40c0 6.6 5.4 12 12 12h40c6.6 0 12-5.4 12-12zm192 0v-40c0-6.6-5.4-12-12-12h-40c-6.6 0-12 5.4-12 12v40c0 6.6 5.4 12 12 12h40c6.6 0 12-5.4 12-12zm96-260v352c0 26.5-21.5 48-48 48H48c-26.5 0-48-21.5-48-48V112c0-26.5 21.5-48 48-48h48V12c0-6.6 5.4-12 12-12h40c6.6 0 12 5.4 12 12v52h128V12c0-6.6 5.4-12 12-12h40c6.6 0 12 5.4 12 12v52h48c26.5 0 48 21.5 48 48zm-48 346V160H48v298c0 3.3 2.7 6 6 6h340c3.3 0 6-2.7 6-6z"
                                                                  />
                                                                </svg>
                                                              </i>
                                                            </div>
                                                          </pdk-date-picker-icon>
                                                        </div>
                                                      </div>
                                                    </pdk-interaction-container>
                                                  </pdk-date-picker-toggle>
                                                </div>
                                              </div>
                                            </div>
                                          </pdk-interaction-container>
                                        </pdk-date-input>
                                      </div>
                                    </div>
                                  </date-picker>
                                </fieldset>
                              </pdk-form-group>
                            </pdk-form-field>
                          </div>
                        </listing-date-range>
                        <pdk-form-field
                          class="govuk-!-padding-top-2"
                          label="For a period of"
                          labeltype="small"
                          pdk-padding-top="2"
                        >
                          <pdk-form-group
                            class="pdk-form-group"
                          >
                            <fieldset
                              class="govuk-fieldset"
                              pdk-fieldset=""
                            >
                              <legend
                                class="govuk-fieldset__legend govuk-fieldset__legend--s"
                              >
                                 For a period of 
                              </legend>
                              <pdk-radio-group
                                class="ng-untouched ng-pristine ng-valid"
                                name="weekCommencingDurationInWeeks"
                                required=""
                              >
                                <div
                                  class="govuk-radios"
                                >
                                  <pdk-radio-button
                                    name="oneWeek"
                                    type="radio"
                                  >
                                    <div
                                      class="govuk-radios__item"
                                    >
                                      <input
                                        class="govuk-radios__input"
                                        disabled=""
                                        id="pdk-radio-GENERATED_ID"
                                        name="pdk-radio-group-GENERATED_ID"
                                        type="radio"
                                        value="1"
                                      />
                                      <label
                                        class="govuk-radios__label govuk-label"
                                        for="pdk-radio-GENERATED_ID"
                                        pdk-label=""
                                      >
                                        One week 
                                      </label>
                                    </div>
                                  </pdk-radio-button>
                                  <pdk-radio-button
                                    name="twoWeeks"
                                    type="radio"
                                  >
                                    <div
                                      class="govuk-radios__item"
                                    >
                                      <input
                                        class="govuk-radios__input"
                                        disabled=""
                                        id="pdk-radio-GENERATED_ID"
                                        name="pdk-radio-group-GENERATED_ID"
                                        type="radio"
                                        value="2"
                                      />
                                      <label
                                        class="govuk-radios__label govuk-label"
                                        for="pdk-radio-GENERATED_ID"
                                        pdk-label=""
                                      >
                                        Two weeks 
                                      </label>
                                    </div>
                                  </pdk-radio-button>
                                </div>
                              </pdk-radio-group>
                            </fieldset>
                          </pdk-form-group>
                        </pdk-form-field>
                        <pdk-form-field
                          label="Hearing duration"
                          labeltype="small"
                        >
                          <pdk-form-group
                            class="pdk-form-group"
                          >
                            <fieldset
                              class="govuk-fieldset"
                              pdk-fieldset=""
                            >
                              <legend
                                class="govuk-fieldset__legend govuk-fieldset__legend--s"
                              >
                                 Hearing duration 
                              </legend>
                              <pdk-time-input
                                class="ng-untouched ng-pristine ng-valid"
                                labelhidden="false"
                                name="duration"
                              >
                                <div
                                  class="pdk-time-input ng-untouched ng-pristine ng-valid"
                                >
                                  <div
                                    class="pdk-time-input__item pdk-time-input__item--hour"
                                  >
                                    <label
                                      class="govuk-label"
                                      for="pdk-time-input-GENERATED_ID-hours"
                                      pdk-label=""
                                    >
                                       Hours 
                                    </label>
                                    <input
                                      autocomplete="off"
                                      class="ng-untouched ng-pristine ng-valid govuk-input govuk-input--width-2"
                                      formcontrolname="hours"
                                      id="pdk-time-input-GENERATED_ID-hours"
                                      maxlength="2"
                                      name="timeHours"
                                      pattern="[0-9]*"
                                      type="text"
                                    />
                                  </div>
                                  <div
                                    class="pdk-time-input__item"
                                  >
                                    <label
                                      class="govuk-label"
                                      for="pdk-time-input-GENERATED_ID-minutes"
                                      pdk-label=""
                                    >
                                       Minutes 
                                    </label>
                                    <input
                                      autocomplete="off"
                                      class="ng-untouched ng-pristine ng-valid govuk-input govuk-input--width-2"
                                      formcontrolname="minutes"
                                      id="pdk-time-input-GENERATED_ID-minutes"
                                      maxlength="2"
                                      minlength="2"
                                      name="timeMinutes"
                                      pattern="[0-9]*"
                                      type="text"
                                    />
                                  </div>
                                </div>
                              </pdk-time-input>
                            </fieldset>
                          </pdk-form-group>
                        </pdk-form-field>
                      </div>
                    </pdk-checkbox-conditional>
                  </div>
                </pdk-radio-group>
              </fieldset>
            </pdk-form-group>
          </pdk-form-field>
        </div>
        <pdk-form-field
          label="Hearing language"
          labeltype="small"
        >
          <pdk-form-group
            class="pdk-form-group"
          >
            <fieldset
              class="govuk-fieldset"
              pdk-fieldset=""
            >
              <legend
                class="govuk-fieldset__legend govuk-fieldset__legend--s"
              >
                 Hearing language 
              </legend>
              <pdk-radio-group
                class="ng-untouched ng-pristine ng-valid"
                name="hearingLanguage"
                required=""
              >
                <div
                  class="govuk-radios"
                >
                  <pdk-radio-button
                    value="ENGLISH"
                  >
                    <div
                      class="govuk-radios__item"
                    >
                      <input
                        class="govuk-radios__input"
                        id="pdk-radio-GENERATED_ID"
                        name="pdk-radio-group-GENERATED_ID"
                        type="radio"
                        value="ENGLISH"
                      />
                      <label
                        class="govuk-radios__label govuk-label"
                        for="pdk-radio-GENERATED_ID"
                        pdk-label=""
                      >
                        English
                      </label>
                    </div>
                  </pdk-radio-button>
                  <pdk-radio-button
                    value="WELSH"
                  >
                    <div
                      class="govuk-radios__item"
                    >
                      <input
                        class="govuk-radios__input"
                        id="pdk-radio-GENERATED_ID"
                        name="pdk-radio-group-GENERATED_ID"
                        type="radio"
                        value="WELSH"
                      />
                      <label
                        class="govuk-radios__label govuk-label"
                        for="pdk-radio-GENERATED_ID"
                        pdk-label=""
                      >
                        Welsh
                      </label>
                    </div>
                  </pdk-radio-button>
                </div>
              </pdk-radio-group>
            </fieldset>
          </pdk-form-group>
        </pdk-form-field>
        <pdk-form-field
          label="Do you want to notify to all relevant parties?"
          labeltype="small"
        >
          <pdk-form-group
            class="pdk-form-group"
          >
            <fieldset
              class="govuk-fieldset"
              pdk-fieldset=""
            >
              <legend
                class="govuk-fieldset__legend govuk-fieldset__legend--s"
              >
                 Do you want to notify to all relevant parties? 
              </legend>
              <pdk-radio-group
                class="ng-untouched ng-pristine ng-valid"
                name="sendNotificationToParties"
                required=""
              >
                <div
                  class="govuk-radios"
                >
                  <pdk-radio-button>
                    <div
                      class="govuk-radios__item"
                    >
                      <input
                        class="govuk-radios__input"
                        id="pdk-radio-GENERATED_ID"
                        name="pdk-radio-group-GENERATED_ID"
                        type="radio"
                        value="true"
                      />
                      <label
                        class="govuk-radios__label govuk-label"
                        for="pdk-radio-GENERATED_ID"
                        pdk-label=""
                      >
                        Yes
                      </label>
                    </div>
                  </pdk-radio-button>
                  <pdk-radio-button>
                    <div
                      class="govuk-radios__item"
                    >
                      <input
                        class="govuk-radios__input"
                        id="pdk-radio-GENERATED_ID"
                        name="pdk-radio-group-GENERATED_ID"
                        type="radio"
                        value="false"
                      />
                      <label
                        class="govuk-radios__label govuk-label"
                        for="pdk-radio-GENERATED_ID"
                        pdk-label=""
                      >
                        No
                      </label>
                    </div>
                  </pdk-radio-button>
                </div>
              </pdk-radio-group>
            </fieldset>
          </pdk-form-group>
        </pdk-form-field>
        <video-hearing>
          <pdk-form-field>
            <pdk-form-group
              class="pdk-form-group"
            >
              <pdk-checkbox
                class="govuk-checkboxes ng-untouched ng-pristine ng-valid"
                name="hasVideoLink"
              >
                <div
                  class="govuk-checkboxes__item"
                >
                  <input
                    class="govuk-checkboxes__input"
                    id="pdk-checkbox-GENERATED_ID"
                    name="hasVideoLink"
                    type="checkbox"
                    value="true"
                  />
                  <label
                    class="govuk-label govuk-checkboxes__label"
                    for="pdk-checkbox-GENERATED_ID"
                  >
                     Video hearing 
                  </label>
                </div>
              </pdk-checkbox>
            </pdk-form-group>
          </pdk-form-field>
          <div
            class="govuk-!-margin-bottom-7"
            pdk-margin-bottom="7"
          >
            <pdk-form-field
              label="Public list note"
              labeltype="small"
            >
              <pdk-form-group
                class="pdk-form-group"
              >
                <label
                  class="govuk-label govuk-label--s"
                  for="public-list-details"
                >
                   Public list note 
                </label>
                <input
                  class="ng-untouched ng-pristine ng-valid govuk-input"
                  id="public-list-details"
                  maxlength="80"
                  name="publicListNote"
                  pdk-input=""
                  pdk-text-input=""
                  type="text"
                />
              </pdk-form-group>
            </pdk-form-field>
          </div>
        </video-hearing>
        <pdk-form-group
          class="pdk-form-group"
        >
          <button
            class="govuk-button"
            data-role="submitBtn"
            id="hearing-details-form-submit"
            pdk-button=""
            type="submit"
          >
             Save and continue 
          </button>
        </pdk-form-group>
        <a
          class="govuk-link"
          href="javascript:void(0)"
          id="cancelHearingForm"
          pdk-link=""
        >
           Cancel 
        </a>
      </form>
    </div>
  </hearing-details-form>
</ng-component>
`;
