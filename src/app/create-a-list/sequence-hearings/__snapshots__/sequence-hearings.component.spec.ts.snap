exports[`Sequence Hearings should not display the reorder component (reorder then cancel) 1`] = `
<test-sequence-hearings
  hearings={[Function Array]}
  judiciary={[Function Array]}
  reorderLists={[Function Boolean]}
  save={[Function Function]}
  selectedDate={[Function String]}
>
  <sequence-hearings
    timeformat="hh:mm a"
  >
    <div
      class="sequence-wrapper"
    >
      <div
        class="sequence-controls"
      >
        <a
          class="link-btn reorder-btn govuk-link"
          href="javascript:void(0)"
          pdk-link=""
        >
          Reorder
        </a>
      </div>
      <hearings-per-judiciary>
        <div
          class="relative-item"
        >
          <table
            class="hearings-per-judge govuk-table"
            pdk-table=""
          >
