                class="pdk-form-group"
              >
                <label
                  class="govuk-label govuk-label--s"
                  for="public-list-details"
                >
                   Public list note 
                </label>
                <input
                  class="ng-untouched ng-pristine ng-valid govuk-input"
                  id="public-list-details"
                  maxlength="80"
                  name="publicListNote"
                  pdk-input=""
                  pdk-text-input=""
                  type="text"
                />
              </pdk-form-group>
            </pdk-form-field>
          </div>
        </video-hearing>
        <pdk-form-group
          class="pdk-form-group"
        >
          <button
            class="govuk-button"
            data-role="submitBtn"
            id="hearing-details-form-submit"
            pdk-button=""
            type="submit"
          >
             Save and continue 
          </button>
        </pdk-form-group>
        <a
          class="govuk-link"
          href="javascript:void(0)"
          id="cancelHearingForm"
          pdk-link=""
        >
           Cancel 
        </a>
      </form>
    </div>
  </hearing-details-form>
</ng-component>
`;

