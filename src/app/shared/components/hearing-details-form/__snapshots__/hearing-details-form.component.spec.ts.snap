                                          class="govuk-!-margin-top-5 govuk-!-margin-bottom-1"
                                          pdk-margin-bottom="1"
                                          pdk-margin-top="5"
                                          role="status"
                                        >
                                          <div
                                            class="govuk-inset-text"
                                          >
                                             Selected day: Wednesday 
                                          </div>
                                        </pdk-inset-text>
                                      </div>
                                    </div>
                                  </date-picker>
                                </fieldset>
                              </pdk-form-group>
                            </pdk-form-field>
                            <pdk-form-field>
                              <pdk-form-group
                                class="pdk-form-group"
                              >
                                <pdk-checkbox
                                  class="govuk-checkboxes ng-untouched ng-pristine ng-valid"
                                  name="multiDay"
                                >
                                  <div
                                    class="govuk-checkboxes__item"
                                  >
                                    <input
                                      class="govuk-checkboxes__input"
                                      id="multiDay"
                                      name="multiDay"
                                      type="checkbox"
                                      value="true"
                                    />
                                    <label
                                      class="govuk-label govuk-checkboxes__label"
                                      for="multiDay"
                                    >
                                       This is a multi-day hearing 
                                    </label>
                                  </div>
                                </pdk-checkbox>
                              </pdk-form-group>
                            </pdk-form-field>
                          </div>
                        </listing-date-range>
                        <br />
                        <pdk-form-field
                          label="Hearing start time"
                          labeltype="small"
                        >
                          <pdk-form-group
                            class="pdk-form-group"
                          >
                            <fieldset
                              class="govuk-fieldset"
                              pdk-fieldset=""
                            >
                              <legend
                                class="govuk-fieldset__legend govuk-fieldset__legend--s"
                              >
                                 Hearing start time 
                              </legend>
                              <pdk-time-input
                                class="ng-untouched ng-valid ng-dirty"
                                labelhidden="false"
                                name="startTime"
                              >
                                <div
                                  class="pdk-time-input ng-pristine ng-valid ng-touched"
                                >
                                  <div
                                    class="pdk-time-input__item pdk-time-input__item--hour"
                                  >
                                    <label
                                      class="govuk-label"
                                      for="pdk-time-input-GENERATED_ID-hours"
                                      pdk-label=""
                                    >
                                       Hours 
                                    </label>
                                    <input
                                      autocomplete="off"
                                      class="ng-untouched ng-pristine ng-valid govuk-input govuk-input--width-2"
                                      formcontrolname="hours"
                                      id="pdk-time-input-GENERATED_ID-hours"
                                      maxlength="2"
                                      name="timeHours"
                                      pattern="[0-9]*"
                                      type="text"
                                    />
                                  </div>
                                  <div
                                    class="pdk-time-input__item"
                                  >
                                    <label
                                      class="govuk-label"
                                      for="pdk-time-input-GENERATED_ID-minutes"
                                      pdk-label=""
                                    >
                                       Minutes 
                                    </label>
                                    <input
                                      autocomplete="off"
                                      class="ng-pristine ng-valid govuk-input govuk-input--width-2 ng-touched"
                                      formcontrolname="minutes"
                                      id="pdk-time-input-GENERATED_ID-minutes"
                                      maxlength="2"
                                      minlength="2"
                                      name="timeMinutes"
                                      pattern="[0-9]*"
                                      type="text"
                                    />
                                  </div>
                                </div>
                              </pdk-time-input>
                            </fieldset>
                          </pdk-form-group>
                        </pdk-form-field>
                        <pdk-form-field
                          label="Hearing duration"
                          labeltype="small"
                        >
                          <pdk-form-group
                            class="pdk-form-group"
                          >
                            <fieldset
                              class="govuk-fieldset"
                              pdk-fieldset=""
                            >
                              <legend
                                class="govuk-fieldset__legend govuk-fieldset__legend--s"
                              >
                                 Hearing duration 
                              </legend>
                              <pdk-time-input
                                class="ng-untouched ng-valid ng-dirty"
                                labelhidden="false"
                                name="duration"
                              >
                                <div
                                  class="pdk-time-input ng-untouched ng-pristine ng-valid"
                                >
                                  <div
                                    class="pdk-time-input__item pdk-time-input__item--hour"
                                  >
                                    <label
                                      class="govuk-label"
                                      for="pdk-time-input-GENERATED_ID-hours"
                                      pdk-label=""
                                    >
                                       Hours 
                                    </label>
                                    <input
                                      autocomplete="off"
                                      class="ng-untouched ng-pristine ng-valid govuk-input govuk-input--width-2"
                                      formcontrolname="hours"
                                      id="pdk-time-input-GENERATED_ID-hours"
                                      maxlength="2"
                                      name="timeHours"
                                      pattern="[0-9]*"
                                      type="text"
                                    />
                                  </div>
                                  <div
                                    class="pdk-time-input__item"
                                  >
                                    <label
                                      class="govuk-label"
                                      for="pdk-time-input-GENERATED_ID-minutes"
                                      pdk-label=""
                                    >
                                       Minutes 
                                    </label>
                                    <input
                                      autocomplete="off"
                                      class="ng-untouched ng-pristine ng-valid govuk-input govuk-input--width-2"
                                      formcontrolname="minutes"
                                      id="pdk-time-input-GENERATED_ID-minutes"
                                      maxlength="2"
                                      minlength="2"
                                      name="timeMinutes"
                                      pattern="[0-9]*"
                                      type="text"
                                    />
                                  </div>
                                </div>
                              </pdk-time-input>
                            </fieldset>
                          </pdk-form-group>
                        </pdk-form-field>
                      </div>
                    </pdk-checkbox-conditional>
                    <pdk-radio-button
                      name="weekCommencing"
                      type="radio"
                      value="weekCommencing"
                    >
                      <div
                        class="govuk-radios__item"
                      >
                        <input
                          class="govuk-radios__input"
                          id="pdk-radio-GENERATED_ID"
                          name="pdk-radio-group-GENERATED_ID"
                          type="radio"
                          value="weekCommencing"
                        />
                        <label
                          class="govuk-radios__label govuk-label"
                          for="pdk-radio-GENERATED_ID"
                          pdk-label=""
                        >
                           Week commencing 
                        </label>
                      </div>
                    </pdk-radio-button>
                  </div>
                </pdk-radio-group>
              </fieldset>
            </pdk-form-group>
          </pdk-form-field>
        </div>
        <pdk-form-field
          label="Hearing language"
          labeltype="small"
        >
          <pdk-form-group
            class="pdk-form-group"
          >
            <fieldset
              class="govuk-fieldset"
              pdk-fieldset=""
            >
              <legend
                class="govuk-fieldset__legend govuk-fieldset__legend--s"
              >
                 Hearing language 
              </legend>
              <pdk-radio-group
                class="ng-untouched ng-pristine ng-valid"
                name="hearingLanguage"
                required=""
              >
                <div
                  class="govuk-radios"
                >
                  <pdk-radio-button
                    value="ENGLISH"
                  >
                    <div
                      class="govuk-radios__item"
                    >
                      <input
                        class="govuk-radios__input"
                        id="pdk-radio-GENERATED_ID"
                        name="pdk-radio-group-GENERATED_ID"
                        type="radio"
                        value="ENGLISH"
                      />
                      <label
                        class="govuk-radios__label govuk-label"
                        for="pdk-radio-GENERATED_ID"
                        pdk-label=""
                      >
                        English
                      </label>
                    </div>
                  </pdk-radio-button>
                  <pdk-radio-button
                    value="WELSH"
                  >
                    <div
                      class="govuk-radios__item"
                    >
                      <input
                        class="govuk-radios__input"
                        id="pdk-radio-GENERATED_ID"
                        name="pdk-radio-group-GENERATED_ID"
                        type="radio"
                        value="WELSH"
                      />
                      <label
                        class="govuk-radios__label govuk-label"
                        for="pdk-radio-GENERATED_ID"
                        pdk-label=""
                      >
                        Welsh
                      </label>
                    </div>
                  </pdk-radio-button>
                </div>
              </pdk-radio-group>
            </fieldset>
          </pdk-form-group>
        </pdk-form-field>
        <pdk-form-field
          label="Do you want to notify to all relevant parties?"
          labeltype="small"
        >
          <pdk-form-group
            class="pdk-form-group"
          >
            <fieldset
              class="govuk-fieldset"
              pdk-fieldset=""
            >
              <legend
                class="govuk-fieldset__legend govuk-fieldset__legend--s"
              >
                 Do you want to notify to all relevant parties? 
              </legend>
              <pdk-radio-group
                class="ng-untouched ng-pristine ng-valid"
                name="sendNotificationToParties"
                required=""
              >
                <div
                  class="govuk-radios"
                >
                  <pdk-radio-button>
                    <div
                      class="govuk-radios__item"
                    >
                      <input
                        class="govuk-radios__input"
                        id="pdk-radio-GENERATED_ID"
                        name="pdk-radio-group-GENERATED_ID"
                        type="radio"
                        value="true"
                      />
                      <label
                        class="govuk-radios__label govuk-label"
                        for="pdk-radio-GENERATED_ID"
                        pdk-label=""
                      >
                        Yes
                      </label>
                    </div>
                  </pdk-radio-button>
                  <pdk-radio-button>
                    <div
                      class="govuk-radios__item"
                    >
                      <input
                        class="govuk-radios__input"
                        id="pdk-radio-GENERATED_ID"
                        name="pdk-radio-group-GENERATED_ID"
                        type="radio"
                        value="false"
                      />
                      <label
                        class="govuk-radios__label govuk-label"
                        for="pdk-radio-GENERATED_ID"
                        pdk-label=""
                      >
                        No
                      </label>
                    </div>
                  </pdk-radio-button>
                </div>
              </pdk-radio-group>
            </fieldset>
          </pdk-form-group>
        </pdk-form-field>
        <video-hearing>
          <pdk-form-field>
            <pdk-form-group
              class="pdk-form-group"
            >
              <pdk-checkbox
                class="govuk-checkboxes ng-untouched ng-pristine ng-valid"
                name="hasVideoLink"
              >
                <div
                  class="govuk-checkboxes__item"
                >
                  <input
                    class="govuk-checkboxes__input"
                    id="pdk-checkbox-GENERATED_ID"
                    name="hasVideoLink"
                    type="checkbox"
                    value="true"
                  />
                  <label
                    class="govuk-label govuk-checkboxes__label"
                    for="pdk-checkbox-GENERATED_ID"
                  >
                     Video hearing 
                  </label>
                </div>
              </pdk-checkbox>
            </pdk-form-group>
          </pdk-form-field>
          <div
            class="govuk-!-margin-bottom-7"
            pdk-margin-bottom="7"
          >
            <pdk-form-field
              label="Public list note"
              labeltype="small"
            >
              <pdk-form-group
                class="pdk-form-group"
              >
                <label
                  class="govuk-label govuk-label--s"
                  for="public-list-details"
                >
                   Public list note 
                </label>
                <input
                  class="ng-untouched ng-pristine ng-valid govuk-input"
                  id="public-list-details"
                  maxlength="80"
                  name="publicListNote"
                  pdk-input=""
                  pdk-text-input=""
                  type="text"
                />
              </pdk-form-group>
            </pdk-form-field>
          </div>
        </video-hearing>
        <pdk-form-group
          class="pdk-form-group"
        >
          <button
            class="govuk-button"
            data-role="submitBtn"
            id="hearing-details-form-submit"
            pdk-button=""
            type="submit"
          >
             Save and continue 
          </button>
        </pdk-form-group>
        <a
          class="govuk-link"
          href="javascript:void(0)"
          id="cancelHearingForm"
          pdk-link=""
        >
           Cancel 
        </a>
      </form>
    </div>
  </hearing-details-form>
</ng-component>
`;

exports[`HearingDetailsFormComponent should show component fields for hearing details a fixed date single day form 1`] = `
<ng-component
  courtCentres={[Function Array]}
  hearing={[Function Object]}
  hearingHasBeenAllocated={[Function Boolean]}
  hearingTypes={[Function Array]}
  selectedCourt={[Function Object]}
  testMinDate={[Function String]}
>
  <hearing-details-form>
    <div
      class="hearing-details-form"
    >
      <form
        class="ng-untouched ng-valid ng-dirty"
        data-test-id="hearingDetailsForm"
        novalidate=""
        pdk-form=""
      >
        <h2
          class="govuk-!-margin-bottom-3 govuk-heading-m"
          pdk-margin-bottom="3"
          pdk-typography="heading-medium"
        >
          Enter hearing details
        </h2>
        <judiciary-input>
          <fieldset
            style="margin-bottom: 0;"
          >
            <legend
              class="govuk-!-margin-bottom-0 govuk-heading-s"
              pdk-margin-bottom="0"
              pdk-typography="heading-small"
            >
               Judiciary (Optional) 
            </legend>
            <pdk-form-field
              class="govuk-!-margin-bottom-1"
              label="Judiciary"
              labeltype="none"
              pdk-margin-bottom="1"
            >
              <pdk-form-group
                class="pdk-form-group"
              >
                <fieldset
                  class="govuk-fieldset"
                  pdk-fieldset=""
                >
                  <legend
                    class="govuk-fieldset__legend govuk-visually-hidden"
                  >
                     Judiciary 
                  </legend>
                  <pdk-checkbox-group
                    class="ng-untouched ng-pristine ng-valid"
                    name="judicialRoleType"
                  >
                    <div
                      class="govuk-checkboxes"
                    >
                      <pdk-checkbox
                        class="govuk-checkboxes"
                      >
                        <div
                          class="govuk-checkboxes__item"
                        >
                          <input
                            class="govuk-checkboxes__input"
                            id="pdk-checkbox-GENERATED_ID"
                            name="pdk-checkbox-group-GENERATED_ID"
                            type="checkbox"
                            value="CIRCUIT_JUDGE"
                          />
                          <label
                            class="govuk-label govuk-checkboxes__label"
                            for="pdk-checkbox-GENERATED_ID"
                          >
                             Judge 
                          </label>
                        </div>
                      </pdk-checkbox>
                      <pdk-checkbox-conditional>
                        <div
                          class="govuk-checkboxes__conditional"
                        >
                          <div
                            aria-hidden="true"
                            class="govuk-!-margin-bottom-1 govuk-body-m"
                            pdk-margin-bottom="1"
                            pdk-typography="body-medium"
                          >
                             Name 
                          </div>
                          <pdk-form-field
                            labeltype="none"
                          >
                            <pdk-form-group
                              class="pdk-form-group"
                            >
                              <label
                                class="govuk-visually-hidden govuk-label"
                                for="judicial-typeahead-GENERATED_ID"
                              >
                                 Circuit judge 
                              </label>
                              <judiciary-typeahead
                                class="ng-untouched ng-pristine ng-valid"
                                data-test-id="CIRCUIT_JUDGE"
                              >
                                <div
                                  class="judiciary-typeahead"
                                >
                                  <pdk-autosuggest-lite
                                    inputtype="search"
                                    suggestionkey="id"
                                    suggestionsubtitle="ljaShortName"
                                    suggestiontitle="judicialMemberName"
                                  >
                                    <pdk-autosuggest
                                      highlightcolor="blue"
                                    >
                                      <pdk-interaction-container>
                                        <div>
                                          <div
                                            class="pdk-autosuggest"
                                          >
                                            <input
                                              aria-autocomplete="list"
                                              aria-controls="pdk-autosuggest__suggestions-container-GENERATED_ID-listbox"
                                              aria-describedby="pdk-autosuggest__instructions-GENERATED_ID judge-label"
                                              aria-expanded="false"
                                              autocomplete="off"
                                              class="pdk-autosuggest__input ng-untouched ng-pristine ng-valid govuk-input"
                                              id="judicial-typeahead-GENERATED_ID"
                                              role="combobox"
                                              type="search"
                                            />
                                            <span
                                              class="govuk-visually-hidden"
                                              id="pdk-autosuggest__instructions-GENERATED_ID"
                                              pdk-visually-hidden=""
                                            >
                                               When autocomplete results are available, use the up and down arrows to review and Enter to select. Touch device users, explore options with swipe gestures. 
                                            </span>
                                            <span
                                              aria-live="polite"
                                              class="govuk-visually-hidden"
                                              pdk-visually-hidden=""
                                              role="status"
                                            >
                                            </span>
                                            <div
                                              class="pdk-autosuggest__suggestions-container"
                                              id="pdk-autosuggest__suggestions-container-GENERATED_ID"
                                            >
                                            </div>
                                          </div>
                                        </div>
                                      </pdk-interaction-container>
                                    </pdk-autosuggest>
                                  </pdk-autosuggest-lite>
                                </div>
                              </judiciary-typeahead>
                            </pdk-form-group>
                          </pdk-form-field>
                        </div>
                      </pdk-checkbox-conditional>
                      <pdk-checkbox
                        class="govuk-checkboxes"
                      >
                        <div
                          class="govuk-checkboxes__item"
                        >
                          <input
                            class="govuk-checkboxes__input"
                            id="pdk-checkbox-GENERATED_ID"
                            name="pdk-checkbox-group-GENERATED_ID"
                            type="checkbox"
                            value="DISTRICT_JUDGE"
                          />
                          <label
                            class="govuk-label govuk-checkboxes__label"
                            for="pdk-checkbox-GENERATED_ID"
                          >
                             District Judge 
                          </label>
                        </div>
                      </pdk-checkbox>
                      <pdk-checkbox-conditional>
                        <div
                          class="govuk-checkboxes__conditional"
                        >
                          <div
                            aria-hidden="true"
                            class="govuk-!-margin-bottom-1 govuk-body-m"
                            pdk-margin-bottom="1"
                            pdk-typography="body-medium"
                          >
                             Name 
                          </div>
                          <pdk-form-field
                            labeltype="none"
                          >
                            <pdk-form-group
                              class="pdk-form-group"
                            >
                              <label
                                class="govuk-visually-hidden govuk-label"
                                for="judicial-typeahead-GENERATED_ID"
                              >
                                 District Judge 
                              </label>
                              <judiciary-typeahead
                                class="ng-untouched ng-pristine ng-valid"
                                data-test-id="DISTRICT_JUDGE"
                              >
                                <div
