                            />
                            <label
                              class="govuk-radios__label govuk-label"
                              for="pdk-radio-GENERATED_ID"
                              pdk-label=""
                            >
                              Yes
                            </label>
                          </div>
                        </pdk-radio-button>
                        <pdk-radio-button
                          data-test-id="notifyFalseValue"
                        >
                          <div
                            class="govuk-radios__item"
                          >
                            <input
                              class="govuk-radios__input"
                              id="pdk-radio-GENERATED_ID"
                              name="pdk-radio-group-GENERATED_ID"
                              type="radio"
                              value="false"
                            />
                            <label
                              class="govuk-radios__label govuk-label"
                              for="pdk-radio-GENERATED_ID"
                              pdk-label=""
                            >
                              No
                            </label>
                          </div>
                        </pdk-radio-button>
                      </div>
                    </pdk-radio-group>
                  </fieldset>
                </pdk-form-group>
              </pdk-form-field>
            </pdk-grid>
          </pdk-grid>
          <div>
            <button
              class="govuk-button"
              data-test-id="submitSlots"
              disabled="disabled"
              pdk-button=""
            >
               Save and continue 
            </button>
          </div>
        </form>
      </div>
    </crown-scheduling-slots>
  </div>
</crown-scheduling>
`;
