// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`SelectedHearingDaysComponent should create the component 1`] = `
<selected-hearing-days
  courtRoomOptions={[Function Function]}
  hearingVM={[Function Function]}
  location={[Function _Location]}
  onSubmitForm={[Function OutputEmitterRef]}
  onValidationError={[Function OutputEmitterRef]}
  selectedHearingDays={[Function Function]}
>
  <no-of-selected-hearing-days>
    <h3
      class="govuk-!-margin-bottom-5 govuk-!-margin-top-8 govuk-heading-m"
      pdk-margin-bottom="5"
      pdk-margin-top="8"
      pdk-typography="heading-medium"
    >
      Hearing days
    </h3>
    <div>
      <div
        class="future-hearingday-selected"
      >
        <span
          class="govuk-body-m"
          data-test-id="no-of-selected-hearing-days"
          pdk-typography="body"
        >
          <b>
            Number of hearing days selected
          </b>
           1 day 
        </span>
      </div>
      <pdk-divider
        class="govuk-!-margin-bottom-1 govuk-!-margin-top-0"
        pdk-margin-bottom="1"
        pdk-margin-top="0"
      >
        <hr
          class="pdk-divider"
        />
      </pdk-divider>
    </div>
  </no-of-selected-hearing-days><pdk-grid
    class="govuk-grid-row"
    container=""
  >
    <pdk-grid
      class="govuk-grid-column-full"
      full=""
    >
      <hearing-days-table>
        <table
          class="govuk-table"
          data-test-id="hearingDayList"
          pdk-table=""
        >
          <thead
            class="govuk-table__head"
            pdk-table-head=""
          >
            <tr
              class="govuk-table__row"
              pdk-table-row=""
            >
              <th
                class="govuk-table__cell"
                pdk-table-header=""
                scope="col"
              >
                Date
              </th>
              <th
                class="govuk-table__cell"
                pdk-table-header=""
                scope="col"
              >
                Court Details
              </th>
              <th
                class="govuk-table__cell"
                pdk-table-header=""
                scope="col"
              >
                Duration
              </th>
              <th
                class="govuk-table__cell"
                pdk-table-header=""
                scope="col"
              >
                Reallocated Courtroom
              </th>
            </tr>
          </thead>
          <tbody
            class="govuk-table__body"
            pdk-table-body=""
          >
            <tr
              class="govuk-table__row"
              data-test-id="sessionListItem"
              pdk-table-row=""
            >
              <td
                class="govuk-table__cell"
                data-test-id="date"
                pdk-table-cell=""
              >
                 18-06-2025 
              </td>
              <td
                class="govuk-table__cell"
                data-test-id="courtDetails"
                pdk-table-cell=""
              >
                Croydon Crown Court
              </td>
              <td
                class="govuk-table__cell"
                data-test-id="duration"
                pdk-table-cell=""
              >
                <duration-cell>
                  <div
                    class="offences"
                    data-test-id="duartion"
                  >
                    <div>
                      2 hours
                    </div>
                    <pdk-tag
                      class="govuk-!-margin-top-2"
                      condensed=""
                      pdk-margin-top="2"
                    >
                      <div
                        class="govuk-tag govuk-tag--turquoise pdk-tag--condensed"
                      >
                        <span>
                           Day 4 of 6
                        </span>
                      </div>
                    </pdk-tag>
                  </div>
                </duration-cell>
              </td>
              <td
                class="govuk-table__cell"
                data-test-id="courtRoomDetails"
                pdk-table-cell=""
              >
              </td>
            </tr>
          </tbody>
        </table>
      </hearing-days-table>
      <courtroom-change-confirmation-form
        confirmationlabel="Are you sure you want to change courtroom for selected hearing days?"
      >
        <form
          class="ng-untouched ng-pristine ng-valid"
          data-test-id="hearingDetailsForm"
          novalidate=""
          pdk-form=""
        >
          <div>
            <pdk-form-field>
              <pdk-form-group
                class="pdk-form-group"
              >
                <fieldset
                  class="govuk-fieldset"
                  pdk-fieldset=""
                >
                  <legend
                    class="govuk-fieldset__legend govuk-fieldset__legend--m"
                  >
                     Are you sure you want to change courtroom for selected hearing days? 
                  </legend>
                  <pdk-radio-group
                    class="ng-untouched ng-pristine ng-valid"
                    inline=""
                    ngmodel=""
                    required=""
                  >
                    <div
                      class="govuk-radios govuk-radios--inline"
                    >
                      <pdk-radio-button>
                        <div
                          class="govuk-radios__item"
                        >
                          <input
                            class="govuk-radios__input"
                            id="pdk-radio-GENERATED_ID"
                            name="pdk-radio-group-GENERATED_ID"
                            type="radio"
                            value="true"
                          />
                          <label
                            class="govuk-radios__label govuk-label"
                            for="pdk-radio-GENERATED_ID"
                            pdk-label=""
                          >
                            Yes
                          </label>
                        </div>
                      </pdk-radio-button>
                      <pdk-radio-button>
                        <div
                          class="govuk-radios__item"
                        >
                          <input
                            class="govuk-radios__input"
                            id="pdk-radio-GENERATED_ID"
                            name="pdk-radio-group-GENERATED_ID"
                            type="radio"
                            value="false"
                          />
                          <label
                            class="govuk-radios__label govuk-label"
                            for="pdk-radio-GENERATED_ID"
                            pdk-label=""
                          >
                            No
                          </label>
                        </div>
                      </pdk-radio-button>
                    </div>
                  </pdk-radio-group>
                </fieldset>
              </pdk-form-group>
            </pdk-form-field>
          </div>
          <div>
            <button
              aria-label="continue"
              class="govuk-!-margin-bottom-0 govuk-button"
              pdk-button=""
              pdk-margin-bottom="0"
              type="submit"
            >
               Continue 
            </button>
          </div>
        </form>
      </courtroom-change-confirmation-form>
    </pdk-grid>
  </pdk-grid>
</selected-hearing-days>
`;
