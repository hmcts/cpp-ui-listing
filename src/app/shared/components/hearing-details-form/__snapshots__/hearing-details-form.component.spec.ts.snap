                      class="govuk-radios__item"
                    >
                      <input
                        class="govuk-radios__input"
                        id="pdk-radio-GENERATED_ID"
                        name="pdk-radio-group-GENERATED_ID"
                        type="radio"
                        value="false"
                      />
                      <label
                        class="govuk-radios__label govuk-label"
                        for="pdk-radio-GENERATED_ID"
                        pdk-label=""
                      >
                        No
                      </label>
                    </div>
                  </pdk-radio-button>
                </div>
              </pdk-radio-group>
            </fieldset>
          </pdk-form-group>
        </pdk-form-field>
        <video-hearing>
          <pdk-form-field>
            <pdk-form-group
              class="pdk-form-group"
            >
              <pdk-checkbox
                class="govuk-checkboxes ng-untouched ng-pristine ng-valid"
                name="hasVideoLink"
              >
                <div
                  class="govuk-checkboxes__item"
                >
                  <input
                    class="govuk-checkboxes__input"
                    id="pdk-checkbox-GENERATED_ID"
                    name="hasVideoLink"
                    type="checkbox"
                    value="true"
                  />
                  <label
                    class="govuk-label govuk-checkboxes__label"
                    for="pdk-checkbox-GENERATED_ID"
                  >
                     Video hearing 
                  </label>
                </div>
              </pdk-checkbox>
            </pdk-form-group>
          </pdk-form-field>
          <div
            class="govuk-!-margin-bottom-7"
            pdk-margin-bottom="7"
          >
            <pdk-form-field
              label="Public list note"
              labeltype="small"
            >
              <pdk-form-group
                class="pdk-form-group"
              >
                <label
                  class="govuk-label govuk-label--s"
                  for="public-list-details"
                >
                   Public list note 
                </label>
                <input
                  class="ng-untouched ng-pristine ng-valid govuk-input"
                  id="public-list-details"
                  maxlength="80"
                  name="publicListNote"
                  pdk-input=""
                  pdk-text-input=""
                  type="text"
                />
              </pdk-form-group>
            </pdk-form-field>
          </div>
        </video-hearing>
        <pdk-form-group
          class="pdk-form-group"
        >
          <button
            class="govuk-button"
            data-role="submitBtn"
            id="hearing-details-form-submit"
            pdk-button=""
            type="submit"
          >
             Save and continue 
          </button>
        </pdk-form-group>
        <a
          class="govuk-link"
          href="javascript:void(0)"
          id="cancelHearingForm"
          pdk-link=""
        >
           Cancel 
        </a>
      </form>
    </div>
  </hearing-details-form>
</ng-component>
`;

