              for="public-list-details"
            >
               Public list note (optional) 
            </label>
            <input
              class="govuk-input ng-untouched ng-pristine ng-valid"
              id="public-list-details"
              maxlength="100"
              name="publicListNote"
              pdk-input=""
              pdk-text-input=""
              type="text"
            />
          </pdk-form-group>
        </pdk-form-field>
        <pdk-form-field
          label="Hearing language"
          labeltype="small"
        >
          <pdk-form-group
            class="pdk-form-group"
          >
