                        type="radio"
                        value="WELSH"
                      />
                      <label
                        class="govuk-radios__label govuk-label"
                        for="pdk-radio-GENERATED_ID"
                        pdk-label=""
                      >
                        Welsh
                      </label>
                    </div>
                  </pdk-radio-button>
                </div>
              </pdk-radio-group>
            </fieldset>
          </pdk-form-group>
        </pdk-form-field>
        <pdk-form-field
          label="Do you want to notify to all relevant parties?"
          labeltype="small"
        >
          <pdk-form-group
            class="pdk-form-group"
          >
            <fieldset
              class="govuk-fieldset"
              pdk-fieldset=""
            >
              <legend
                class="govuk-fieldset__legend govuk-fieldset__legend--s"
              >
                 Do you want to notify to all relevant parties? 
              </legend>
              <pdk-radio-group
                class="ng-untouched ng-pristine ng-valid"
                name="sendNotificationToParties"
                required=""
              >
                <div
                  class="govuk-radios"
                >
                  <pdk-radio-button>
                    <div
                      class="govuk-radios__item"
                    >
                      <input
                        class="govuk-radios__input"
                        id="pdk-radio-GENERATED_ID"
                        name="pdk-radio-group-GENERATED_ID"
                        type="radio"
                        value="true"
                      />
                      <label
                        class="govuk-radios__label govuk-label"
                        for="pdk-radio-GENERATED_ID"
                        pdk-label=""
                      >
                        Yes
                      </label>
                    </div>
                  </pdk-radio-button>
                  <pdk-radio-button>
                    <div
                      class="govuk-radios__item"
                    >
                      <input
                        class="govuk-radios__input"
                        id="pdk-radio-GENERATED_ID"
                        name="pdk-radio-group-GENERATED_ID"
                        type="radio"
                        value="false"
                      />
                      <label
                        class="govuk-radios__label govuk-label"
                        for="pdk-radio-GENERATED_ID"
                        pdk-label=""
                      >
                        No
                      </label>
                    </div>
                  </pdk-radio-button>
                </div>
              </pdk-radio-group>
            </fieldset>
          </pdk-form-group>
        </pdk-form-field>
        <video-hearing>
          <pdk-form-field>
            <pdk-form-group
              class="pdk-form-group"
            >
              <pdk-checkbox
                class="govuk-checkboxes ng-untouched ng-pristine ng-valid"
                name="hasVideoLink"
              >
                <div
                  class="govuk-checkboxes__item"
                >
                  <input
                    class="govuk-checkboxes__input"
                    id="pdk-checkbox-GENERATED_ID"
                    name="hasVideoLink"
                    type="checkbox"
                    value="true"
                  />
                  <label
                    class="govuk-label govuk-checkboxes__label"
                    for="pdk-checkbox-GENERATED_ID"
                  >
                     Video hearing 
                  </label>
                </div>
              </pdk-checkbox>
            </pdk-form-group>
          </pdk-form-field>
          <div
            class="govuk-!-margin-bottom-7"
            pdk-margin-bottom="7"
          >
            <pdk-form-field
              label="Public list note"
              labeltype="small"
            >
              <pdk-form-group
                class="pdk-form-group"
              >
                <label
                  class="govuk-label govuk-label--s"
                  for="public-list-details"
                >
                   Public list note 
                </label>
                <input
                  class="ng-untouched ng-pristine ng-valid govuk-input"
                  id="public-list-details"
                  maxlength="80"
                  name="publicListNote"
                  pdk-input=""
                  pdk-text-input=""
                  type="text"
                />
              </pdk-form-group>
            </pdk-form-field>
          </div>
        </video-hearing>
        <pdk-form-group
          class="pdk-form-group"
        >
          <button
            class="govuk-button"
            data-role="submitBtn"
            id="hearing-details-form-submit"
            pdk-button=""
            type="submit"
          >
             Save and continue 
          </button>
        </pdk-form-group>
        <a
          class="govuk-link"
          href="javascript:void(0)"
          id="cancelHearingForm"
          pdk-link=""
        >
           Cancel 
        </a>
      </form>
    </div>
  </hearing-details-form>
</ng-component>
`;

