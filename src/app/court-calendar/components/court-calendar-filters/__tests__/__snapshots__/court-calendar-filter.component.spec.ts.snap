                                              type="radio"
                                              value="AD"
                                            />
                                            <label
                                              class="govuk-radios__label govuk-label"
                                              for="pdk-radio-GENERATED_ID"
                                              pdk-label=""
                                            >
                                               All day 
                                            </label>
                                          </div>
                                        </pdk-radio-button>
                                      </div>
                                    </pdk-radio-group>
                                  </fieldset>
                                </pdk-form-group>
                              </pdk-form-field>
                            </div>
                          </div>
                        </court-calendar-filter-fields>
                      </div>
                    </pdk-radio-conditional>
                  </pdk-grid>
                </div>
              </pdk-radio-group>
            </fieldset>
          </pdk-form-group>
        </pdk-form-field>
        <div
