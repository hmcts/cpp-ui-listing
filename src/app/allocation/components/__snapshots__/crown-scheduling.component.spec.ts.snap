exports[`CrownSchedulingComponent should raise an error summary 1`] = `
<crown-scheduling
  CrownSessionStatus={[Function Object]}
  allocationFormConfigs={[Function Object]}
  currentPage={[Function Function]}
  errors={[Function Array]}
  filters={[Function Function]}
  filtersSubmit={[Function OutputEmitterRef]}
  hearingSlotAllocationsSubmit={[Function OutputEmitterRef]}
  hearingSlots={[Function Function]}
  hearingSlotsCancel={[Function OutputEmitterRef]}
  hearingTypes={[Function Function]}
  organisationUnits={[Function Function]}
  pageChange={[Function OutputEmitterRef]}
  pageSize={[Function Function]}
  rotaBusinessTypes={[Function Function]}
  slotsRef="undefined"
  totalResults={[Function Function]}
>
  <pdk-error-summary>
    <div
      class="govuk-error-summary"
      tabindex="-1"
    >
      <div
        aria-labelledby="pdk-error-sumamry-GENERATED_ID"
        role="alert"
      >
        <h2
          class="govuk-error-summary__title"
          id="pdk-error-sumamry-GENERATED_ID"
        >
          There is a problem
        </h2>
        <div
          class="govuk-error-summary__body"
        >
          <ul
            class="govuk-list govuk-error-summary__list"
          >
            <li>
              <a
                href="javascript:void(0)"
              >
                 Error message 
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </pdk-error-summary><div
    class="govuk-!-margin-bottom-6 govuk-!-padding-left-6 govuk-!-padding-right-6"
    pdk-margin-bottom="6"
    pdk-padding-left="6"
    pdk-padding-right="6"
  >
    <crown-scheduling-filters>
      <div
        class="scheduling-filters-wrapper"
      >
        <h2
          class="govuk-heading-m"
          pdk-typography="heading-medium"
        >
          Search for a hearing slot
        </h2>
        <form
          class="ng-untouched ng-pristine ng-valid"
          data-test-id="crownSchedulingFiltersForm"
          novalidate=""
          pdk-form=""
        >
          <scheduling-filters-court-and-booking
            jurisdiction="CROWN"
          >
            <pdk-grid
              class="govuk-grid-row"
              container=""
            >
              <pdk-grid
                class="govuk-grid-column-one-third"
                one-third=""
              >
                <pdk-form-field>
                  <pdk-form-group
                    class="pdk-form-group"
                  >
                    <label
                      class="govuk-label"
                      for="pdk-select-GENERATED_ID"
                    >
                       Operational unit 
                    </label>
                    <pdk-select
                      class="ng-untouched ng-pristine ng-invalid"
                      justified=""
                      placeholder="Choose operational unit"
                      required=""
                    >
                      <select
                        class="govuk-select pdk-select--justified"
                        id="pdk-select-GENERATED_ID"
                        name="oucodeL2Code"
                        required=""
                      >
                        <option
                          value=""
                        >
                          Choose operational unit
                        </option>
                      </select>
                    </pdk-select>
                  </pdk-form-group>
                </pdk-form-field>
              </pdk-grid>
              <pdk-grid
                class="govuk-grid-column-one-third"
                one-third=""
              >
                <pdk-form-field
                  label="Court"
                >
                  <pdk-form-group
                    class="pdk-form-group"
                  >
                    <label
                      class="govuk-label"
                      for="pdk-form-control-undefined-GENERATED_ID"
                    >
                       Court 
                    </label>
                    <cpp-organisation-unit-autosuggest
                      class="ng-untouched ng-pristine ng-invalid"
                      name="organisationUnit"
                      required=""
                    >
                      <pdk-autosuggest-lite>
                        <pdk-autosuggest
                          highlightcolor="blue"
                        >
                          <pdk-interaction-container>
                            <div>
                              <div
                                class="pdk-autosuggest"
                              >
                                <input
                                  aria-autocomplete="list"
                                  aria-controls="pdk-autosuggest__suggestions-container-GENERATED_ID-listbox"
                                  aria-describedby="pdk-autosuggest__instructions-GENERATED_ID"
                                  aria-expanded="false"
                                  autocomplete="off"
                                  class="pdk-autosuggest__input ng-untouched ng-pristine ng-valid govuk-input"
                                  id="pdk-form-control-undefined-GENERATED_ID"
                                  role="combobox"
                                  type="text"
                                />
                                <span
                                  class="govuk-visually-hidden"
                                  id="pdk-autosuggest__instructions-GENERATED_ID"
                                  pdk-visually-hidden=""
                                >
                                   When autocomplete results are available, use the up and down arrows to review and Enter to select. Touch device users, explore options with swipe gestures. 
                                </span>
                                <span
                                  aria-live="polite"
                                  class="govuk-visually-hidden"
                                  pdk-visually-hidden=""
                                  role="status"
                                >
                                </span>
                                <div
                                  class="pdk-autosuggest__suggestions-container"
                                  id="pdk-autosuggest__suggestions-container-GENERATED_ID"
                                >
                                </div>
                              </div>
                            </div>
                          </pdk-interaction-container>
                        </pdk-autosuggest>
                      </pdk-autosuggest-lite>
                    </cpp-organisation-unit-autosuggest>
                  </pdk-form-group>
                </pdk-form-field>
              </pdk-grid>
              <pdk-grid
                class="govuk-grid-column-one-third"
                one-third=""
              >
                <div
                  schedulingfilterscourtroom=""
                >
                  <pdk-form-field
                    label="Courtroom"
                  >
                    <pdk-form-group
                      class="pdk-form-group"
                    >
                      <label
                        class="govuk-label"
                        for="pdk-select-GENERATED_ID"
                      >
                         Courtroom 
                      </label>
                      <pdk-select
                        class="ng-untouched ng-pristine ng-valid"
                        justified=""
                        name="sessionStatusFilter"
                      >
                        <select
                          class="govuk-select pdk-select--justified"
                          id="pdk-select-GENERATED_ID"
                          name="sessionStatusFilter"
                        >
                          <option
                            value="ALL"
                          >
                             All 
                          </option>
                        </select>
                      </pdk-select>
                    </pdk-form-group>
                  </pdk-form-field>
                </div>
              </pdk-grid>
            </pdk-grid>
            <pdk-grid
              class="govuk-grid-row"
              container=""
            >
              <pdk-grid
                class="govuk-grid-column-one-third"
                one-third=""
              >
                <pdk-form-field
                  label="Booking type"
                  labeltype="small"
                >
                  <pdk-form-group
                    class="pdk-form-group"
                  >
                    <fieldset
                      class="govuk-fieldset"
                      pdk-fieldset=""
                    >
                      <legend
                        class="govuk-fieldset__legend govuk-fieldset__legend--s"
                      >
                         Booking type 
                      </legend>
                      <pdk-radio-group
                        class="ng-untouched ng-pristine ng-valid"
                        name="bookingType"
                        small=""
                      >
                        <div
                          class="govuk-radios govuk-radios--small"
                        >
                          <pdk-radio-button>
                            <div
                              class="govuk-radios__item"
                            >
                              <input
                                class="govuk-radios__input"
                                id="pdk-radio-GENERATED_ID"
                                name="pdk-radio-group-GENERATED_ID"
                                type="radio"
                                value="true"
                              />
                              <label
                                class="govuk-radios__label govuk-label"
                                for="pdk-radio-GENERATED_ID"
                                pdk-label=""
                              >
                                Slot based
                              </label>
                            </div>
                          </pdk-radio-button>
                          <pdk-hint
                            class="govuk-hint"
                            style="display: block;"
                          >
                            <div>
                              For example, PSR
                            </div>
                          </pdk-hint>
                          <pdk-radio-button>
                            <div
                              class="govuk-radios__item"
                            >
                              <input
                                class="govuk-radios__input"
                                id="pdk-radio-GENERATED_ID"
                                name="pdk-radio-group-GENERATED_ID"
                                type="radio"
                                value="false"
                              />
                              <label
                                class="govuk-radios__label govuk-label"
                                for="pdk-radio-GENERATED_ID"
                                pdk-label=""
                              >
                                Duration based
                              </label>
                            </div>
                          </pdk-radio-button>
                          <pdk-hint
                            class="govuk-hint"
                            style="display: block;"
                          >
                            <div>
                              For example, Trial
                            </div>
                          </pdk-hint>
                          <pdk-radio-conditional>
                            <div
                              class="govuk-radios__conditional"
                            >
                              <pdk-form-field
                                label="Search for a multi-day hearing?"
                                labeltype="small"
                              >
                                <pdk-form-group
                                  class="pdk-form-group"
                                >
                                  <fieldset
                                    class="govuk-fieldset"
                                    pdk-fieldset=""
                                  >
                                    <legend
                                      class="govuk-fieldset__legend govuk-fieldset__legend--s"
                                    >
                                       Search for a multi-day hearing? 
                                    </legend>
                                    <pdk-radio-group
                                      class="ng-untouched ng-pristine ng-valid"
                                      name="multiday"
                                      small=""
                                    >
                                      <div
                                        class="govuk-radios govuk-radios--small"
                                      >
                                        <pdk-radio-button>
                                          <div
                                            class="govuk-radios__item"
                                          >
                                            <input
                                              class="govuk-radios__input"
                                              id="pdk-radio-GENERATED_ID"
                                              name="pdk-radio-group-GENERATED_ID"
                                              type="radio"
                                              value="true"
                                            />
                                            <label
                                              class="govuk-radios__label govuk-label"
                                              for="pdk-radio-GENERATED_ID"
                                              pdk-label=""
                                            >
                                              Yes
                                            </label>
                                          </div>
                                        </pdk-radio-button>
                                        <pdk-radio-button>
                                          <div
                                            class="govuk-radios__item"
                                          >
                                            <input
                                              class="govuk-radios__input"
                                              id="pdk-radio-GENERATED_ID"
                                              name="pdk-radio-group-GENERATED_ID"
                                              type="radio"
                                              value="false"
                                            />
                                            <label
                                              class="govuk-radios__label govuk-label"
                                              for="pdk-radio-GENERATED_ID"
                                              pdk-label=""
                                            >
                                              No
                                            </label>
                                          </div>
                                        </pdk-radio-button>
                                        <pdk-radio-conditional>
                                          <div
                                            class="govuk-radios__conditional"
                                          >
                                            <pdk-form-field
                                              label="Hearing duration"
                                              labeltype="small"
                                            >
                                              <pdk-form-group
                                                class="pdk-form-group"
                                              >
                                                <fieldset
