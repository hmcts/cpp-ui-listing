                            class="ng-untouched ng-pristine ng-valid govuk-input govuk-input--width-2"
                            formcontrolname="minutes"
                            id="pdk-time-input-GENERATED_ID-minutes"
                            maxlength="2"
                            minlength="2"
                            name="timeMinutes"
                            pattern="[0-9]*"
                            type="text"
                          />
                        </div>
                      </div>
