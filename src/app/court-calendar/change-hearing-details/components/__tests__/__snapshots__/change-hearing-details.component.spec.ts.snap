// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`ChangeHearingDetailsComponent Change Hearing Screen Rendering should render correct controls for a Crown hearing 1`] = `
<change-hearing-details
  allocateHearingFactory={[Function AllocateHearingFactory]}
  datePipe={[Function _DatePipe]}
  hearingSlots={[Function Function]}
  initialValues={[Function Function]}
  onCancel={[Function OutputEmitterRef]}
  onSubmit={[Function OutputEmitterRef]}
  onValidationError={[Function OutputEmitterRef]}
  selectedCourtCentre={[Function Function]}
  selectedHearing={[Function Function]}
>
  <pdk-grid
    class="govuk-grid-row"
    container=""
  >
    <pdk-grid
      class="govuk-grid-column-one-third"
      one-third=""
    >
      <form
        class="ng-untouched ng-valid ng-dirty"
        data-test-id="hearingDetailsForm"
        novalidate=""
        pdk-form=""
      >
        <pdk-form-field
