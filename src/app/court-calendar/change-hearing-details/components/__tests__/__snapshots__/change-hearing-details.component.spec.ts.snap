          labeltype="small"
        >
          <pdk-form-group
            class="pdk-form-group"
          >
            <label
              class="govuk-label govuk-label--s"
              for="pdk-form-control-undefined-GENERATED_ID"
            >
               Hearing type 
            </label>
            <cpp-hearing-type-autosuggest
              class="ng-untouched ng-pristine ng-valid"
              jurisdictiontype="initialValues.jurisdictionType"
              name="selectedHearingType"
              placeholder="All hearing types"
              required=""
            >
              <pdk-autosuggest-lite>
                <pdk-autosuggest
                  highlightcolor="blue"
                >
                  <pdk-interaction-container>
                    <div>
                      <div
                        class="pdk-autosuggest"
                      >
                        <input
                          aria-autocomplete="list"
                          aria-controls="pdk-autosuggest__suggestions-container-GENERATED_ID-listbox"
                          aria-describedby="pdk-autosuggest__instructions-GENERATED_ID"
                          aria-expanded="false"
                          autocomplete="off"
                          class="pdk-autosuggest__input ng-untouched ng-pristine ng-valid govuk-input"
                          id="pdk-form-control-undefined-GENERATED_ID"
                          role="combobox"
                          type="text"
                        />
                        <span
                          class="govuk-visually-hidden"
                          id="pdk-autosuggest__instructions-GENERATED_ID"
                          pdk-visually-hidden=""
                        >
                           When autocomplete results are available, use the up and down arrows to review and Enter to select. Touch device users, explore options with swipe gestures. 
                        </span>
                        <span
                          aria-live="polite"
                          class="govuk-visually-hidden"
                          pdk-visually-hidden=""
                          role="status"
                        >
                        </span>
                        <div
                          class="pdk-autosuggest__suggestions-container"
                          id="pdk-autosuggest__suggestions-container-GENERATED_ID"
                        >
                        </div>
                      </div>
                    </div>
                  </pdk-interaction-container>
                </pdk-autosuggest>
              </pdk-autosuggest-lite>
            </cpp-hearing-type-autosuggest>
          </pdk-form-group>
        </pdk-form-field>
        <change-hearing-crown-control
          class="ng-untouched ng-valid ng-dirty"
          name="dateRange"
        >
          <div>
            <h4
              class="govuk-!-margin-bottom-1"
              pdk-margin-bottom="1"
            >
              Start date
            </h4>
            <p
              class="govuk-!-margin-top-1"
              pdk-margin-top="1"
            >
               28 January 2025 
            </p>
            <pdk-form-field>
              <pdk-form-group
                class="pdk-form-group"
              >
                <pdk-checkbox
                  class="govuk-checkboxes ng-untouched ng-pristine ng-valid"
                  name="multiDay"
                >
                  <div
                    class="govuk-checkboxes__item"
                  >
                    <input
                      class="govuk-checkboxes__input"
                      id="multiDay"
                      name="multiDay"
                      type="checkbox"
                      value="true"
                    />
                    <label
                      class="govuk-label govuk-checkboxes__label"
                      for="multiDay"
                    >
                       This is a multi-day hearing 
                    </label>
                  </div>
                </pdk-checkbox>
              </pdk-form-group>
            </pdk-form-field>
            <change-hearing-start-time-controls>
              <div
                class="timeDuration"
              >
                <pdk-form-field
                  label="Start time"
                  labeltype="small"
                >
                  <pdk-form-group
                    class="pdk-form-group"
                  >
                    <fieldset
                      class="govuk-fieldset"
                      pdk-fieldset=""
                    >
                      <legend
                        class="govuk-fieldset__legend govuk-fieldset__legend--s"
                      >
                         Start time 
                      </legend>
                      <pdk-time-input
                        autoshift="false"
                        class="ng-untouched ng-valid ng-dirty"
                        labelhidden="false"
                        name="startTime"
                        required=""
                      >
                        <div
                          class="pdk-time-input ng-untouched ng-pristine ng-valid"
                        >
                          <div
                            class="pdk-time-input__item pdk-time-input__item--hour"
                          >
                            <label
                              class="govuk-label"
                              for="pdk-time-input-GENERATED_ID-hours"
                              pdk-label=""
                            >
                               Hours 
                            </label>
                            <input
                              autocomplete="off"
                              class="ng-untouched ng-pristine govuk-input govuk-input--width-2 ng-valid"
                              formcontrolname="hours"
                              id="pdk-time-input-GENERATED_ID-hours"
                              maxlength="2"
                              name="timeHours"
                              pattern="[0-9]*"
                              required=""
                              type="text"
                            />
                          </div>
                          <div
                            class="pdk-time-input__item"
                          >
                            <label
                              class="govuk-label"
                              for="pdk-time-input-GENERATED_ID-minutes"
                              pdk-label=""
                            >
                               Minutes 
                            </label>
                            <input
                              autocomplete="off"
                              class="ng-untouched ng-pristine govuk-input govuk-input--width-2 ng-valid"
                              formcontrolname="minutes"
                              id="pdk-time-input-GENERATED_ID-minutes"
                              maxlength="2"
                              minlength="2"
                              name="timeMinutes"
                              pattern="[0-9]*"
                              required=""
                              type="text"
                            />
                          </div>
                        </div>
                      </pdk-time-input>
                    </fieldset>
                  </pdk-form-group>
                </pdk-form-field>
                <pdk-form-field
                  label="Duration"
                  labeltype="small"
                >
                  <pdk-form-group
                    class="pdk-form-group"
                  >
                    <fieldset
                      class="govuk-fieldset"
                      pdk-fieldset=""
                    >
                      <legend
                        class="govuk-fieldset__legend govuk-fieldset__legend--s"
                      >
                         Duration 
                      </legend>
                      <pdk-time-input
                        autoshift="false"
                        class="ng-untouched ng-valid ng-dirty"
                        labelhidden="false"
                        name="duration"
                        required=""
                      >
                        <div
                          class="pdk-time-input ng-untouched ng-pristine ng-valid"
                        >
                          <div
                            class="pdk-time-input__item pdk-time-input__item--hour"
                          >
                            <label
                              class="govuk-label"
                              for="pdk-time-input-GENERATED_ID-hours"
                              pdk-label=""
                            >
                               Hours 
                            </label>
                            <input
                              autocomplete="off"
                              class="ng-untouched ng-pristine govuk-input govuk-input--width-2 ng-valid"
                              formcontrolname="hours"
                              id="pdk-time-input-GENERATED_ID-hours"
                              maxlength="2"
                              name="timeHours"
                              pattern="[0-9]*"
                              required=""
                              type="text"
                            />
                          </div>
                          <div
                            class="pdk-time-input__item"
                          >
                            <label
                              class="govuk-label"
                              for="pdk-time-input-GENERATED_ID-minutes"
                              pdk-label=""
                            >
                               Minutes 
                            </label>
                            <input
                              autocomplete="off"
                              class="ng-untouched ng-pristine govuk-input govuk-input--width-2 ng-valid"
                              formcontrolname="minutes"
                              id="pdk-time-input-GENERATED_ID-minutes"
                              maxlength="2"
                              minlength="2"
                              name="timeMinutes"
                              pattern="[0-9]*"
                              required=""
                              type="text"
                            />
                          </div>
                        </div>
                      </pdk-time-input>
                    </fieldset>
                  </pdk-form-group>
                </pdk-form-field>
              </div>
            </change-hearing-start-time-controls>
          </div>
        </change-hearing-crown-control>
        <judiciary-input>
          <fieldset
            class="no-border"
            style="margin-bottom: 0;"
          >
            <legend
              class="govuk-!-margin-bottom-0 no-border govuk-heading-s"
              pdk-margin-bottom="0"
              pdk-typography="heading-small"
            >
