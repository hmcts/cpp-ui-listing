                            </pdk-form-field>
                          </div>
                        </listing-date-range>
                        <pdk-form-field
                          class="govuk-!-padding-top-2"
                          label="For a period of"
                          labeltype="small"
                          pdk-padding-top="2"
                        >
                          <pdk-form-group
                            class="pdk-form-group"
                          >
                            <fieldset
                              class="govuk-fieldset"
                              pdk-fieldset=""
                            >
                              <legend
                                class="govuk-fieldset__legend govuk-fieldset__legend--s"
                              >
                                 For a period of 
                              </legend>
                              <pdk-radio-group
                                class="ng-untouched ng-pristine ng-valid"
                                name="weekCommencingDurationInWeeks"
                                required=""
                              >
                                <div
