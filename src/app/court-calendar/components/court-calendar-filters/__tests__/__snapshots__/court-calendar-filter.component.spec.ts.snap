                                                aria-expanded="false"
                                                aria-haspopup="dialog"
                                                class="pdk-date-picker-input__selection-text govuk-!-padding-right-6 ng-untouched ng-pristine ng-valid govuk-input"
                                                id="pdk-form-control-undefined-GENERATED_ID"
                                                pdk-input=""
                                                pdk-padding-right="6"
                                                readonly="true"
                                                role="button"
                                              />
                                            </div>
                                          </div>
                                        </div>
                                      </div>
