exports[`CrownSchedulingComponent should render a search containing no results 1`] = `
<crown-scheduling
  CrownSessionStatus={[Function Object]}
  allocationFormConfigs={[Function Object]}
  currentPage={[Function Function]}
  filters={[Function Function]}
  filtersSubmit={[Function OutputEmitterRef]}
  hearingSlotAllocationsSubmit={[Function OutputEmitterRef]}
  hearingSlots={[Function Function]}
  hearingSlotsCancel={[Function OutputEmitterRef]}
  hearingTypes={[Function Function]}
  organisationUnits={[Function Function]}
  pageChange={[Function OutputEmitterRef]}
  pageSize={[Function Function]}
  rotaBusinessTypes={[Function Function]}
  slotsRef="undefined"
  totalResults={[Function Function]}
>
  <div
    class="govuk-!-margin-bottom-6 govuk-!-padding-left-6 govuk-!-padding-right-6"
    pdk-margin-bottom="6"
    pdk-padding-left="6"
    pdk-padding-right="6"
  >
    <crown-scheduling-filters>
      <div
        class="scheduling-filters-wrapper"
      >
        <h2
          class="govuk-heading-m"
          pdk-typography="heading-medium"
        >
          Search for a hearing slot
        </h2>
        <form
          class="ng-untouched ng-pristine ng-valid"
          data-test-id="crownSchedulingFiltersForm"
          novalidate=""
          pdk-form=""
        >
          <scheduling-filters-court-and-booking
            jurisdiction="CROWN"
          >
            <pdk-grid
              class="govuk-grid-row"
              container=""
            >
              <pdk-grid
                class="govuk-grid-column-one-third"
                one-third=""
              >
                <pdk-form-field>
                  <pdk-form-group
                    class="pdk-form-group"
                  >
                    <label
                      class="govuk-label"
                      for="pdk-select-GENERATED_ID"
                    >
                       Operational unit 
                    </label>
                    <pdk-select
                      class="ng-untouched ng-pristine ng-invalid"
                      justified=""
                      placeholder="Choose operational unit"
                      required=""
                    >
                      <select
                        class="govuk-select pdk-select--justified"
                        id="pdk-select-GENERATED_ID"
                        name="oucodeL2Code"
                        required=""
                      >
                        <option
                          value=""
                        >
                          Choose operational unit
                        </option>
                      </select>
                    </pdk-select>
                  </pdk-form-group>
                </pdk-form-field>
              </pdk-grid>
              <pdk-grid
                class="govuk-grid-column-one-third"
                one-third=""
              >
                <pdk-form-field
                  label="Court"
                >
                  <pdk-form-group
                    class="pdk-form-group"
                  >
                    <label
                      class="govuk-label"
                      for="pdk-form-control-undefined-GENERATED_ID"
                    >
                       Court 
                    </label>
                    <cpp-organisation-unit-autosuggest
                      class="ng-untouched ng-pristine ng-invalid"
                      name="organisationUnit"
                      required=""
                    >
                      <pdk-autosuggest-lite>
                        <pdk-autosuggest
                          highlightcolor="blue"
                        >
                          <pdk-interaction-container>
                            <div>
                              <div
                                class="pdk-autosuggest"
                              >
                                <input
                                  aria-autocomplete="list"
                                  aria-controls="pdk-autosuggest__suggestions-container-GENERATED_ID-listbox"
                                  aria-describedby="pdk-autosuggest__instructions-GENERATED_ID"
                                  aria-expanded="false"
                                  autocomplete="off"
                                  class="pdk-autosuggest__input ng-untouched ng-pristine ng-valid govuk-input"
                                  id="pdk-form-control-undefined-GENERATED_ID"
                                  role="combobox"
                                  type="text"
                                />
                                <span
                                  class="govuk-visually-hidden"
                                  id="pdk-autosuggest__instructions-GENERATED_ID"
                                  pdk-visually-hidden=""
                                >
                                   When autocomplete results are available, use the up and down arrows to review and Enter to select. Touch device users, explore options with swipe gestures. 
                                </span>
                                <span
                                  aria-live="polite"
                                  class="govuk-visually-hidden"
                                  pdk-visually-hidden=""
                                  role="status"
                                >
                                </span>
                                <div
                                  class="pdk-autosuggest__suggestions-container"
                                  id="pdk-autosuggest__suggestions-container-GENERATED_ID"
                                >
