                                  <pdk-date-picker-input
                                    class="ng-untouched ng-pristine ng-valid"
                                    data-test-id="sessionEndDate"
                                    name="endDate"
                                  >
                                    <pdk-interaction-container>
                                      <div>
                                        <div
                                          style="position: relative;"
                                        >
                                          <div>
                                            <div
                                              class="pdk-date-picker-input__selection govuk-!-padding-0"
                                              pdk-padding="0"
                                            >
                                              <span
                                                hidden=""
                                                id="datePickerSelector-pdk-form-control-undefined-GENERATED_ID"
