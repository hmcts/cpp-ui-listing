            </legend>
            <pdk-form-field
              class="govuk-!-margin-bottom-1"
              label="Judiciary"
              labeltype="none"
              pdk-margin-bottom="1"
            >
              <pdk-form-group
                class="pdk-form-group"
              >
                <fieldset
                  class="govuk-fieldset"
                  pdk-fieldset=""
                >
                  <legend
                    class="govuk-fieldset__legend govuk-visually-hidden"
                  >
                     Judiciary 
                  </legend>
                  <pdk-checkbox-group
                    class="ng-untouched ng-pristine ng-valid"
                    name="judicialRoleType"
                  >
                    <div
                      class="govuk-checkboxes"
                    >
                      <pdk-checkbox
                        class="govuk-checkboxes"
                      >
                        <div
                          class="govuk-checkboxes__item"
                        >
                          <input
                            class="govuk-checkboxes__input"
                            id="pdk-checkbox-GENERATED_ID"
                            name="pdk-checkbox-group-GENERATED_ID"
                            type="checkbox"
                            value="CIRCUIT_JUDGE"
                          />
                          <label
                            class="govuk-label govuk-checkboxes__label"
                            for="pdk-checkbox-GENERATED_ID"
                          >
                             Judge 
                          </label>
                        </div>
                      </pdk-checkbox>
                      <pdk-checkbox
                        class="govuk-checkboxes"
                      >
                        <div
                          class="govuk-checkboxes__item"
                        >
                          <input
                            class="govuk-checkboxes__input"
                            id="pdk-checkbox-GENERATED_ID"
                            name="pdk-checkbox-group-GENERATED_ID"
                            type="checkbox"
                            value="DISTRICT_JUDGE"
                          />
                          <label
                            class="govuk-label govuk-checkboxes__label"
                            for="pdk-checkbox-GENERATED_ID"
                          >
                             District Judge 
                          </label>
                        </div>
                      </pdk-checkbox>
                      <pdk-checkbox
                        class="govuk-checkboxes"
                      >
                        <div
                          class="govuk-checkboxes__item"
                        >
                          <input
                            class="govuk-checkboxes__input"
                            id="pdk-checkbox-GENERATED_ID"
                            name="pdk-checkbox-group-GENERATED_ID"
                            type="checkbox"
                            value="DEPUTY_DISTRICT_JUDGE"
                          />
                          <label
                            class="govuk-label govuk-checkboxes__label"
                            for="pdk-checkbox-GENERATED_ID"
                          >
                             Deputy District Judge 
                          </label>
                        </div>
                      </pdk-checkbox>
                      <pdk-checkbox
                        class="govuk-checkboxes"
                      >
                        <div
                          class="govuk-checkboxes__item"
                        >
                          <input
                            class="govuk-checkboxes__input"
                            id="pdk-checkbox-GENERATED_ID"
                            name="pdk-checkbox-group-GENERATED_ID"
                            type="checkbox"
                            value="RECORDER"
                          />
                          <label
                            class="govuk-label govuk-checkboxes__label"
                            for="pdk-checkbox-GENERATED_ID"
                          >
                             Recorder 
                          </label>
                        </div>
                      </pdk-checkbox>
                      <pdk-checkbox
                        class="govuk-checkboxes ng-untouched ng-pristine ng-valid"
                        style="margin-bottom: 10px;"
                        value="MAGISTRATE"
                      >
                        <div
                          class="govuk-checkboxes__item"
                        >
                          <input
                            class="govuk-checkboxes__input"
                            id="pdk-checkbox-GENERATED_ID"
                            name="pdk-checkbox-group-GENERATED_ID"
                            type="checkbox"
                            value="MAGISTRATE"
                          />
                          <label
                            class="govuk-label govuk-checkboxes__label"
                            for="pdk-checkbox-GENERATED_ID"
                          >
                             Magistrates 
                          </label>
                        </div>
                      </pdk-checkbox>
                    </div>
                  </pdk-checkbox-group>
                </fieldset>
              </pdk-form-group>
            </pdk-form-field>
          </fieldset>
        </judiciary-input>
        <pdk-form-field
