                    </div>
                  </pdk-checkbox-group>
                </fieldset>
              </pdk-form-group>
            </pdk-form-field>
          </fieldset>
        </judiciary-input>
        <pdk-form-field
          class="govuk-!-margin-top-5"
          label="Court"
          labeltype="small"
          pdk-margin-top="5"
        >
