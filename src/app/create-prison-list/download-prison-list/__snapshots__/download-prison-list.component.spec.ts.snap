exports[`DownloadPrisonListComponent prison list button should show Prison List button for Crown court 1`] = `
<ng-component
  crownSelected="false"
  hasAllocatedHearingsByDateRange={[Function Boolean]}
  isPrisonAdminOrHmctsUser={[Function Boolean]}
  selectedCourtCentre={[Function Object]}
  selectedOptions={[Function Object]}
>
  <download-prison-list>
    <div>
      <pdk-inset-text>
        <div
          class="govuk-inset-text"
        >
           18 December 2018 
          <br />
        </div>
      </pdk-inset-text>
      <button
        class="download-file prison-list govuk-button govuk-button--secondary"
        pdk-button="secondary"
        type="button"
      >
        <span>
          Prison list
        </span>
        <i
          class="listing-vector-icon pdk-!-text-color-black"
          pdk-text-colour="black"
        >
          <svg
            height="100%"
            width="100%"
          >
            <use
              xlink:href="assets\\svg-icons-definitions.svg#arrow-right-action"
            />
          </svg>
        </i>
      </button>
    </div>
  </download-prison-list>
</ng-component>
`;

