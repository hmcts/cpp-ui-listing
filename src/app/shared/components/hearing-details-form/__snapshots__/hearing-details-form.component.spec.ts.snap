          class="pdk-form-group"
        >
          <button
            class="govuk-button"
            data-role="submitBtn"
            id="hearing-details-form-submit"
            pdk-button=""
            type="submit"
          >
             Save and continue 
          </button>
        </pdk-form-group>
        <a
          class="govuk-link"
          href="javascript:void(0)"
          id="cancelHearingForm"
          pdk-link=""
        >
           Cancel 
        </a>
      </form>
    </div>
  </hearing-details-form>
</ng-component>
`;

